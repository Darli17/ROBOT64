-- //FUNCTIONS\\

local function room(msg)
    local humroot = workspace.char
    
    local RS = game.ReplicatedStorage
    local rooms = RS.Assets.mapdebris
    local room = rooms[msg]:Clone()

    humroot.Anchored = true
    room.Parent = workspace
    humroot.CFrame = room.TeleMap.CFrame
    task.wait(1)
    humroot.Anchored = false
    task.wait(2)
    room:Destroy()
end
local function telemap(msg)
    local humroot = workspace.char

    for i,v in ipairs(workspace.hub:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "TeleMap" then
            if v.to.Value == msg then
                humroot.Anchored = true
                humroot.CFrame = v.CFrame
                task.wait(1)
                humroot.Anchored = false
            end
        end
    end
end

