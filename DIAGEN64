local function outfit(msg)
    local visfolder = game.ReplicatedStorage.Assets.Vis

    local outfit1 = visfolder[msg]
    local outfitDEF = visfolder.Default

    outfitDEF.Name = msg.."2"
    outfit1.Name = "Default"
    outfi1DEF.Name = msg
end

local function room(msg)
    local RS = game.ReplicatedStorage
    local rooms = RS.Assets.mapdebris
    local room = rooms[msg]:Clone()

    workspace.char.Anchored = true
    room.Parent = workspace
    workspace.char.CFrame = room.TeleMap.CFrame
    task.wait(1)
    workspace.char.Anchored = false
    task.wait(2)
    room:Destroy()
end
local function telemap(msg)
    for i,v in ipairs(workspace.hub:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "TeleMap" then
            if v.to.Value == msg then
                workspace.char.Anchored = true
                workspace.char.CFrame = v.CFrame
                task.wait(1)
                workspace.char.Anchored = false
            end
        end
    end
end

